  "item": [
    {
      "name": "Cykl rezerwacji",
      "item": [
        {
          "name": "Wolne urządzenia Copy - przed utworzeniem rezerwacji",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"API zwraca kod 200\", ()=>{\r",
                  "    pm.response.to.have.status(200)\r",
                  "})\r",
                  "\r",
                  "let body = pm.response.json()\r",
                  "\r",
                  "pm.test(\"API zwraca tablicę\", ()=> {\r",
                  "    pm.expect(Array.isArray(body)).to.be.true\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Każdy element tablicy ma dodatni, całkowity identyfikator\", ()=>{\r",
                  "    body.forEach((element) => {\r",
                  "        pm.expect(element.identyfikator).to.be.above(0)\r",
                  "        pm.expect(Number.isInteger(element.identyfikator)).to.be.true\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Każdy element ma niepustą nazwę tekstową\", ()=>{\r",
                  "    body.forEach((element)=> {\r",
                  "        pm.expect(element.nazwa_urządzenia).to.be.a('string')\r",
                  "        pm.expect(element.nazwa_urządzenia.trim().length).to.be.above(0)\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Czy istnieje urządzenie o id = 4\", ()=>{\r",
                  "    pm.expect(body.find(element => element.identyfikator === 4)).to.not.eql(undefined)\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/devices/available",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "devices",
                "available"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Utworzenie rezerwacji - sukces Copy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"API zwraca kod 201\",() => {\r",
                  "    pm.response.to.have.status(201)\r",
                  "})\r",
                  "\r",
                  "pm.test(\"API zwraca odpowiedź 'created'\", ()=> {\r",
                  "    pm.expect(pm.response.json().status).to.eql(\"created\")\r",
                  "})\r",
                  "\r",
                  "pm.test(\"API zwraca dodatnie całkowite reservation_id\", ()=>{\r",
                  "    const body = pm.response.json();\r",
                  "\r",
                  "    pm.expect(Number.isInteger(body.reservation_id)).to.eql(true)\r",
                  "    pm.expect(body.reservation_id).to.be.above(0)\r",
                  "\r",
                  "    pm.collectionVariables.set(\"reservation_id\", body.reservation_id)\r",
                  "})\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
